# Supabase Database Configuration
# Get these from your Supabase project: Settings → Database → Connection string

# Database host (from Supabase: Settings → Database → Host)
DB_HOST=db.yourproject.supabase.co

# Database port (default for Supabase)
DB_PORT=5432

# Database name (always 'postgres' for Supabase)
DB_NAME=postgres

# Read-only user for Streamlit app (create this after init)
DB_USER=app_read
DB_PASSWORD=your-readonly-password

# Admin user for ETL scripts (default Supabase admin)
DB_ADMIN_USER=postgres
DB_ADMIN_PW=your-supabase-password
