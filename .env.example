# Neon Database Configuration
# Get these from your Neon project: Connection Details

# Database host (from Neon connection string)
DB_HOST=ep-your-endpoint.region.aws.neon.tech

# Database port (standard PostgreSQL port with IPv4 support)
DB_PORT=5432

# Database name (default 'neondb' or your chosen name)
DB_NAME=neondb

# Database user (from Neon connection string, typically 'neondb_owner')
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password

# Admin user for ETL scripts (same as DB_USER in Neon)
DB_ADMIN_USER=neondb_owner
DB_ADMIN_PW=your-neon-password
